[debug] [2026-08-27T23:01:06.963Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/achievers-cat/rulesets {"name":"projects/achievers-cat/rulesets/25340393-6fc9-4844-b5cf-1b2502b3e1e7","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // --------------------------------------------------\n    // HELPER FUNCTIONS\n    // --------------------------------------------------\n\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function isOwner(uid) {\n      return signedIn()\n        && request.auth.uid == uid;\n    }\n\n    function isAdmin() {\n      return signedIn()\n        && get(\n          /databases/$(database)/documents/profiles/$(request.auth.uid)\n        ).data.role == 'admin';\n    }\n\n\n    // --------------------------------------------------\n    // PROFILES\n    // --------------------------------------------------\n\n    match /profiles/{uid} {\n\n      allow read:\n        if isOwner(uid) || isAdmin();\n\n      allow create:\n        if isOwner(uid)\n        && !request.resource.data.keys().hasAny(['role']);\n\n      allow update:\n        if isAdmin()\n        || (\n          isOwner(uid)\n          && !request.resource.data\n            .diff(resource.data)\n            .affectedKeys()\n            .hasAny(['role'])\n        );\n\n      allow delete:\n        if isAdmin();\n    }\n\n    match /materials/{materialId} {\n      allow read:\n        if signedIn()\n        && (resource.data.published == true || isAdmin());\n\n      allow create, update, delete:\n        if isAdmin();\n    }\n\n\n    // --------------------------------------------------\n    // MOCKS\n    // --------------------------------------------------\n\n    match /mocks/{mockId} {\n\n      allow read:\n        if signedIn()\n        && (\n          resource.data.status == 'published'\n          || isAdmin()\n        );\n\n      allow create, update, delete:\n        if isAdmin();\n    }\n\n\n    match /question_assets/{assetId} {\n\n      allow read:\n        if signedIn();\n\n      allow create, update, delete:\n        if isAdmin();\n    }\n\n\n    match /mock_file_chunks/{chunkId} {\n\n      allow read:\n        if signedIn()\n        && get(\n          /databases/$(database)/documents/mocks/$(resource.data.mockId)\n        ).data.status == 'published';\n\n      allow create, update, delete:\n        if isAdmin();\n    }\n\n\n    match /mock_sections/{id} {\n\n      allow read:\n        if signedIn()\n        && (\n          isAdmin()\n          ||\n          get(\n            /databases/$(database)/documents/mocks/$(resource.data.mockId)\n          ).data.status == 'published'\n        );\n\n      allow create, update, delete:\n        if isAdmin();\n    }\n\n\n    // --------------------------------------------------\n    // QUESTIONS\n    // --------------------------------------------------\n\n    match /questions/{questionId} {\n\n      allow read:\n        if signedIn();\n\n      allow create, update, delete:\n        if isAdmin();\n    }\n\n\n    match /question_options/{optionId} {\n\n      // Correct answers remain admin-only.\n      allow read, create, update, delete:\n        if isAdmin();\n    }\n\n\n    // --------------------------------------------------\n    // DAILY CONTENT\n    // --------------------------------------------------\n\n    match /daily_packages/{date} {\n\n      allow read:\n        if signedIn();\n\n      allow create, update, delete:\n        if isAdmin();\n    }\n\n\n    match /daily_questions/{id} {\n\n      allow read:\n        if signedIn();\n\n      allow create, update, delete:\n        if isAdmin();\n    }\n\n\n    match /daily_rcs/{id} {\n\n      allow read:\n        if signedIn();\n\n      allow create, update, delete:\n        if isAdmin();\n    }\n\n\n    // --------------------------------------------------\n    // USER STREAKS\n    // --------------------------------------------------\n\n    // One document per student. A streak is updated when a\n    // Daily Practice section is successfully submitted.\n    match /user_streaks/{uid} {\n\n      allow read: if isOwner(uid) || isAdmin();\n\n      allow create: if isOwner(uid)\n        && request.resource.data.userId == request.auth.uid\n        && request.resource.data.currentStreak is number\n        && request.resource.data.longestStreak is number\n        && request.resource.data.lastActivityDate is string;\n\n      allow update: if isOwner(uid)\n        && request.resource.data.userId == request.auth.uid\n        && request.resource.data.currentStreak is number\n        && request.resource.data.longestStreak is number\n        && request.resource.data.lastActivityDate is string;\n\n      allow delete: if isAdmin();\n    }\n\n\n    // --------------------------------------------------\n    // DAILY SECTION STATS\n    // --------------------------------------------------\n\n    match /daily_section_stats/{id} {\n\n      allow read:\n        if signedIn();\n\n\n      // Student can create the counter\n      // when the first person attempts.\n      allow create:\n        if signedIn()\n        && request.resource.data.count == 1\n        && request.resource.data.date is string\n        && request.resource.data.section\n          in ['quant', 'varc', 'dilr'];\n\n\n      // Student can increment the counter\n      // by exactly one.\n      allow update:\n        if signedIn()\n        && request.resource.data.count ==\n          resource.data.count + 1\n        && request.resource.data.date ==\n          resource.data.date\n        && request.resource.data.section ==\n          resource.data.section;\n\n\n      allow delete:\n        if isAdmin();\n    }\n\n\n    // --------------------------------------------------\n    // DAILY ATTEMPTS\n    // --------------------------------------------------\n\n    match /daily_attempts/{id} {\n\n      // Students can see their own attempt.\n      // Admin can see all attempts.\n      allow read:\n        if signedIn()\n        && (\n          resource.data.userId == request.auth.uid\n          || isAdmin()\n        );\n\n\n      // Student can create their own attempt.\n      allow create:\n        if signedIn()\n        && request.resource.data.userId ==\n          request.auth.uid\n        && request.resource.data.date is string\n        && request.resource.data.section\n          in ['quant', 'varc', 'dilr']\n        && request.resource.data.score is number\n        && request.resource.data.correct is number\n        && request.resource.data.wrong is number\n        && request.resource.data.total is number;\n\n\n      // Student can update only their own attempt.\n      allow update:\n        if signedIn()\n        && (\n          isAdmin()\n          ||\n          (\n            resource.data.userId ==\n              request.auth.uid\n            &&\n            request.resource.data.userId ==\n              request.auth.uid\n            &&\n            request.resource.data.date ==\n              resource.data.date\n            &&\n            request.resource.data.section ==\n              resource.data.section\n          )\n        );\n\n\n      allow delete:\n        if isAdmin();\n    }\n\n\n    // --------------------------------------------------\n    // DAILY LEADERBOARDS\n    //\n    // IMPORTANT:\n    //\n    // Correct structure:\n    //\n    // daily_leaderboards\n    //   /2026-08-27_quant\n    //      /entries\n    //         /USER_UID\n    //\n    // This avoids the invalid collection path:\n    //\n    // daily_leaderboards/2026-08-27/quant/entries\n    // --------------------------------------------------\n\n    match /daily_leaderboards/{leaderboardId}/entries/{uid} {\n\n      // Live rankings are intentionally public so visitors can\n      // see today's leaderboard without signing in.\n      allow read:\n        if true;\n\n\n      // Student can create ONLY their own entry.\n      //\n      // The leaderboard entry must match the daily attempt\n      // created in the SAME transaction.\n      allow create:\n        if signedIn()\n        && uid == request.auth.uid\n\n        && request.resource.data.userId ==\n          request.auth.uid\n\n        && request.resource.data.date is string\n\n        && request.resource.data.section\n          in ['quant', 'varc', 'dilr']\n\n        && request.resource.data.score is number\n        && request.resource.data.correct is number\n        && request.resource.data.wrong is number\n        && request.resource.data.total is number\n\n        && leaderboardId ==\n          request.resource.data.date + '_' +\n          request.resource.data.section\n\n        && request.resource.data.date ==\n          getAfter(\n            /databases/$(database)/documents/daily_attempts/$(request.resource.data.date + '_' + request.resource.data.section + '_' + request.auth.uid)\n          ).data.date\n\n        && request.resource.data.section ==\n          getAfter(\n            /databases/$(database)/documents/daily_attempts/$(request.resource.data.date + '_' + request.resource.data.section + '_' + request.auth.uid)\n          ).data.section\n\n        && request.resource.data.score ==\n          getAfter(\n            /databases/$(database)/documents/daily_attempts/$(request.resource.data.date + '_' + request.resource.data.section + '_' + request.auth.uid)\n          ).data.score\n\n        && request.resource.data.correct ==\n          getAfter(\n            /databases/$(database)/documents/daily_attempts/$(request.resource.data.date + '_' + request.resource.data.section + '_' + request.auth.uid)\n          ).data.correct\n\n        && request.resource.data.wrong ==\n          getAfter(\n            /databases/$(database)/documents/daily_attempts/$(request.resource.data.date + '_' + request.resource.data.section + '_' + request.auth.uid)\n          ).data.wrong\n\n        && request.resource.data.total ==\n          getAfter(\n            /databases/$(database)/documents/daily_attempts/$(request.resource.data.date + '_' + request.resource.data.section + '_' + request.auth.uid)\n          ).data.total;\n\n\n      // A student's leaderboard entry may be refreshed when a new\n      // submission is being saved. It must still belong to that student\n      // and must exactly match the attempt written in the same transaction.\n      allow update:\n        if signedIn()\n        && uid == request.auth.uid\n        && request.resource.data.userId == request.auth.uid\n        && request.resource.data.date is string\n        && request.resource.data.section in ['quant', 'varc', 'dilr']\n        && request.resource.data.score is number\n        && request.resource.data.correct is number\n        && request.resource.data.wrong is number\n        && request.resource.data.total is number\n        && leaderboardId ==\n          request.resource.data.date + '_' +\n          request.resource.data.section\n        && request.resource.data.date ==\n          getAfter(\n            /databases/$(database)/documents/daily_attempts/$(request.resource.data.date + '_' + request.resource.data.section + '_' + request.auth.uid)\n          ).data.date\n        && request.resource.data.section ==\n          getAfter(\n            /databases/$(database)/documents/daily_attempts/$(request.resource.data.date + '_' + request.resource.data.section + '_' + request.auth.uid)\n          ).data.section\n        && request.resource.data.score ==\n          getAfter(\n            /databases/$(database)/documents/daily_attempts/$(request.resource.data.date + '_' + request.resource.data.section + '_' + request.auth.uid)\n          ).data.score\n        && request.resource.data.correct ==\n          getAfter(\n            /databases/$(database)/documents/daily_attempts/$(request.resource.data.date + '_' + request.resource.data.section + '_' + request.auth.uid)\n          ).data.correct\n        && request.resource.data.wrong ==\n          getAfter(\n            /databases/$(database)/documents/daily_attempts/$(request.resource.data.date + '_' + request.resource.data.section + '_' + request.auth.uid)\n          ).data.wrong\n        && request.resource.data.total ==\n          getAfter(\n            /databases/$(database)/documents/daily_attempts/$(request.resource.data.date + '_' + request.resource.data.section + '_' + request.auth.uid)\n          ).data.total;\n\n      allow delete:\n        if isAdmin();\n    }\n\n\n    // --------------------------------------------------\n    // GENERAL ATTEMPTS\n    // --------------------------------------------------\n\n    match /attempts/{attemptId} {\n\n      allow read:\n        if signedIn()\n        && (\n          // The app checks this deterministic document before a first\n          // attempt exists, so resource.data is unavailable at that point.\n          attemptId.matches('^' + request.auth.uid + '_.*')\n          || resource.data.userId == request.auth.uid\n          || isAdmin()\n        );\n\n      allow create:\n        if signedIn()\n        && request.resource.data.userId == request.auth.uid\n        && request.resource.data.mockId is string\n        && attemptId == request.auth.uid + '_' + request.resource.data.mockId\n        && request.resource.data.status == 'in_progress';\n\n      allow update:\n        if signedIn()\n        && (\n          resource.data.userId == request.auth.uid\n          && request.resource.data.userId == request.auth.uid\n          && request.resource.data.mockId == resource.data.mockId\n          && resource.data.status == 'in_progress'\n          && request.resource.data.status == 'submitted'\n          || isAdmin()\n        );\n\n      allow delete:\n        if isAdmin();\n    }\n\n\n    // --------------------------------------------------\n    // ATTEMPT ANSWERS\n    // --------------------------------------------------\n\n    match /attempt_answers/{answerId} {\n\n      allow read:\n        if signedIn()\n        && (\n          resource.data.userId ==\n            request.auth.uid\n          || isAdmin()\n        );\n\n      allow create:\n        if signedIn()\n        && request.resource.data.userId ==\n          request.auth.uid;\n\n      allow update:\n        if signedIn()\n        && (\n          isAdmin()\n          ||\n          (\n            resource.data.userId ==\n              request.auth.uid\n            &&\n            request.resource.data.userId ==\n              request.auth.uid\n          )\n        );\n\n      allow delete:\n        if isAdmin();\n    }\n\n\n    // --------------------------------------------------\n    // RESULTS\n    // --------------------------------------------------\n\n    match /results/{resultId} {\n\n      allow read:\n        if signedIn()\n        && (\n          resource.data.userId ==\n            request.auth.uid\n          || isAdmin()\n        );\n\n      // Results remain admin/server controlled.\n      allow create, update, delete:\n        if isAdmin();\n    }\n\n\n    // --------------------------------------------------\n    // MATERIAL CATEGORIES\n    // --------------------------------------------------\n\n    match /material_categories/{id} {\n\n      allow read:\n        if signedIn();\n\n      allow create, update, delete:\n        if isAdmin();\n    }\n\n\n    // --------------------------------------------------\n    // MATERIALS\n    // --------------------------------------------------\n\n    match /materials/{id} {\n\n      allow read:\n        if signedIn()\n        && (\n          resource.data.published == true\n          || isAdmin()\n        );\n\n      allow create, update, delete:\n        if isAdmin();\n    }\n\n\n    // --------------------------------------------------\n    // ADMIN LOGS\n    // --------------------------------------------------\n\n    match /admin_logs/{id} {\n\n      allow read, create, update, delete:\n        if isAdmin();\n    }\n  }\n}\n","name":"firebase/firestore.rules"}]},"createTime":"2026-08-27T23:01:06.818255Z","metadata":{"services":["cloud.firestore"]}}
