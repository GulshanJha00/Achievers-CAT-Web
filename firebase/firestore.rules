rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && get(
          /databases/$(database)/documents/profiles/$(request.auth.uid)
        ).data.role == 'admin';
    }


    // ---------------------------------------------------------
    // Profiles
    // ---------------------------------------------------------

    match /profiles/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(['role']);

      allow update: if isAdmin()
        || (
          isOwner(uid)
          && !request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasAny(['role'])
        );

      allow delete: if isAdmin();
    }


    // ---------------------------------------------------------
    // Mocks
    // ---------------------------------------------------------

    match /mocks/{mockId} {
      allow read: if signedIn()
        && (
          resource.data.status == 'published'
          || isAdmin()
        );

      allow create, update, delete: if isAdmin();
    }


    // ---------------------------------------------------------
    // Question assets
    // ---------------------------------------------------------

    match /question_assets/{assetId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }


    // ---------------------------------------------------------
    // Mock file chunks
    // ---------------------------------------------------------

    match /mock_file_chunks/{chunkId} {
      allow read: if signedIn()
        && get(
          /databases/$(database)/documents/mocks/$(resource.data.mockId)
        ).data.status == 'published';

      allow create, update, delete: if isAdmin();
    }


    // ---------------------------------------------------------
    // Mock sections
    // ---------------------------------------------------------

    match /mock_sections/{id} {
      allow read: if signedIn()
        && (
          isAdmin()
          || get(
            /databases/$(database)/documents/mocks/$(resource.data.mockId)
          ).data.status == 'published'
        );

      allow create, update, delete: if isAdmin();
    }


    // ---------------------------------------------------------
    // Questions
    // ---------------------------------------------------------

    match /questions/{questionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }


    // ---------------------------------------------------------
    // Question options
    // ---------------------------------------------------------

    // Correct answers must not be queried by students
    // during a live mock.
    match /question_options/{optionId} {
      allow read, create, update, delete: if isAdmin();
    }


    // ---------------------------------------------------------
    // Daily packages
    // ---------------------------------------------------------

    match /daily_packages/{date} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }


    // ---------------------------------------------------------
    // Daily section statistics
    // ---------------------------------------------------------

    // Stores the number of students who attempted
    // each section on each day.
    //
    // Example:
    // daily_section_stats/2026-08-27_quant
    //
    // {
    //   date: "2026-08-27",
    //   section: "quant",
    //   count: 5
    // }

    match /daily_section_stats/{id} {

      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.date is string
        && request.resource.data.section is string
        && request.resource.data.section in [
          'quant',
          'varc',
          'dilr'
        ]
        && request.resource.data.count == 1;

      allow update: if signedIn()
        && request.resource.data.date == resource.data.date
        && request.resource.data.section == resource.data.section
        && request.resource.data.section in [
          'quant',
          'varc',
          'dilr'
        ]
        && request.resource.data.count == resource.data.count + 1;

      allow delete: if isAdmin();
    }


    // ---------------------------------------------------------
    // Daily attempts
    // ---------------------------------------------------------

    // One document per student, per section, per day.
    //
    // Example:
    // daily_attempts/2026-08-27_quant_USER_ID

    match /daily_attempts/{id} {

      allow read: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.date is string
        && request.resource.data.section is string
        && request.resource.data.section in [
          'quant',
          'varc',
          'dilr'
        ]
        && !exists(
          /databases/$(database)/documents/daily_attempts/$(id)
        );

      allow update: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      allow delete: if isAdmin();
    }


    // ---------------------------------------------------------
    // Daily questions
    // ---------------------------------------------------------

    match /daily_questions/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }


    // ---------------------------------------------------------
    // Daily RCs
    // ---------------------------------------------------------

    match /daily_rcs/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }


    // ---------------------------------------------------------
    // General attempts
    // ---------------------------------------------------------

    match /attempts/{attemptId} {
      allow read: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      allow delete: if isAdmin();
    }


    // ---------------------------------------------------------
    // Attempt answers
    // ---------------------------------------------------------

    match /attempt_answers/{answerId} {

      allow read: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        )
        && (
          isAdmin()
          || request.resource.data.userId == request.auth.uid
        );

      allow delete: if isAdmin();
    }


    // ---------------------------------------------------------
    // Results
    // ---------------------------------------------------------

    match /results/{resultId} {

      allow read: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      // Results should be written by trusted server/admin code.
      allow create, update, delete: if isAdmin();
    }


    // ---------------------------------------------------------
    // Materials
    // ---------------------------------------------------------

    match /material_categories/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }


    match /materials/{id} {
      allow read: if signedIn()
        && (
          resource.data.published == true
          || isAdmin()
        );

      allow create, update, delete: if isAdmin();
    }


    // ---------------------------------------------------------
    // Admin logs
    // ---------------------------------------------------------

    match /admin_logs/{id} {
      allow read, create, update, delete: if isAdmin();
    }
  }
}