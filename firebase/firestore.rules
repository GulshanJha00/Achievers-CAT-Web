rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------
    // HELPER FUNCTIONS
    // --------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn()
        && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && get(
          /databases/$(database)/documents/profiles/$(request.auth.uid)
        ).data.role == 'admin';
    }


    // --------------------------------------------------
    // PROFILES
    // --------------------------------------------------

    match /profiles/{uid} {

      allow read:
        if isOwner(uid) || isAdmin();

      allow create:
        if isOwner(uid)
        && !request.resource.data.keys().hasAny(['role']);

      allow update:
        if isAdmin()
        || (
          isOwner(uid)
          && !request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasAny(['role'])
        );

      allow delete:
        if isAdmin();
    }


    // --------------------------------------------------
    // MOCKS
    // --------------------------------------------------

    match /mocks/{mockId} {

      allow read:
        if signedIn()
        && (
          resource.data.status == 'published'
          || isAdmin()
        );

      allow create, update, delete:
        if isAdmin();
    }


    // --------------------------------------------------
    // QUESTION ASSETS
    // --------------------------------------------------

    match /question_assets/{assetId} {

      allow read:
        if signedIn();

      allow create, update, delete:
        if isAdmin();
    }


    // --------------------------------------------------
    // MOCK FILE CHUNKS
    // --------------------------------------------------

    match /mock_file_chunks/{chunkId} {

      allow read:
        if signedIn()
        && get(
          /databases/$(database)/documents/mocks/$(resource.data.mockId)
        ).data.status == 'published';

      allow create, update, delete:
        if isAdmin();
    }


    // --------------------------------------------------
    // MOCK SECTIONS
    // --------------------------------------------------

    match /mock_sections/{id} {

      allow read:
        if signedIn()
        && (
          isAdmin()
          ||
          get(
            /databases/$(database)/documents/mocks/$(resource.data.mockId)
          ).data.status == 'published'
        );

      allow create, update, delete:
        if isAdmin();
    }


    // --------------------------------------------------
    // QUESTIONS
    // --------------------------------------------------

    match /questions/{questionId} {

      allow read:
        if signedIn();

      allow create, update, delete:
        if isAdmin();
    }


    // --------------------------------------------------
    // QUESTION OPTIONS
    // --------------------------------------------------

    match /question_options/{optionId} {

      // Correct answers remain admin-only.
      allow read, create, update, delete:
        if isAdmin();
    }


    // --------------------------------------------------
    // DAILY CONTENT
    // --------------------------------------------------

    match /daily_packages/{date} {

      allow read:
        if signedIn();

      allow create, update, delete:
        if isAdmin();
    }


    match /daily_questions/{id} {

      allow read:
        if signedIn();

      allow create, update, delete:
        if isAdmin();
    }


    match /daily_rcs/{id} {

      allow read:
        if signedIn();

      allow create, update, delete:
        if isAdmin();
    }


    // --------------------------------------------------
    // USER STREAKS
    // --------------------------------------------------

    // One document per student.
    //
    // A streak is updated when a Daily Practice
    // section is successfully submitted.
    //
    // Completing ANY ONE of the three daily sections
    // is enough to keep the streak alive.

    match /user_streaks/{uid} {

      allow read:
        if isOwner(uid) || isAdmin();

      allow create:
        if isOwner(uid)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.currentStreak is number
        && request.resource.data.longestStreak is number
        && request.resource.data.lastActivityDate is string;

      allow update:
        if isOwner(uid)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.currentStreak is number
        && request.resource.data.longestStreak is number
        && request.resource.data.lastActivityDate is string;

      allow delete:
        if isAdmin();
    }


    // --------------------------------------------------
    // DAILY SECTION STATS
    // --------------------------------------------------

    match /daily_section_stats/{id} {

      allow read:
        if signedIn();


      // Student can create the counter
      // when the first person attempts.

      allow create:
        if signedIn()
        && request.resource.data.count == 1
        && request.resource.data.date is string
        && request.resource.data.section
          in ['quant', 'varc', 'dilr'];


      // Student can increment the counter
      // by exactly one.

      allow update:
        if signedIn()
        && request.resource.data.count ==
          resource.data.count + 1
        && request.resource.data.date ==
          resource.data.date
        && request.resource.data.section ==
          resource.data.section;


      allow delete:
        if isAdmin();
    }


    // --------------------------------------------------
    // DAILY ATTEMPTS
    // --------------------------------------------------

    match /daily_attempts/{id} {

      // Students can see their own attempt.
      // Admin can see all attempts.

      allow read:
        if signedIn()
        && (
          resource.data.userId ==
            request.auth.uid
          || isAdmin()
        );


      // Student can create their own attempt.

      allow create:
        if signedIn()
        && request.resource.data.userId ==
          request.auth.uid
        && request.resource.data.date is string
        && request.resource.data.section
          in ['quant', 'varc', 'dilr']
        && request.resource.data.score is number
        && request.resource.data.correct is number
        && request.resource.data.wrong is number
        && request.resource.data.total is number;


      // Student can update only their own attempt.
      // Admin can update anything.

      allow update:
        if signedIn()
        && (
          isAdmin()
          ||
          (
            resource.data.userId ==
              request.auth.uid
            &&
            request.resource.data.userId ==
              request.auth.uid
            &&
            request.resource.data.date ==
              resource.data.date
            &&
            request.resource.data.section ==
              resource.data.section
          )
        );


      allow delete:
        if isAdmin();
    }


    // --------------------------------------------------
    // DAILY LEADERBOARDS
    // --------------------------------------------------
    //
    // Structure:
    //
    // daily_leaderboards
    //   /2026-08-27_quant
    //      /entries
    //         /USER_UID
    //
    // daily_leaderboards
    //   /2026-08-27_varc
    //      /entries
    //         /USER_UID
    //
    // daily_leaderboards
    //   /2026-08-27_dilr
    //      /entries
    //         /USER_UID
    //
    // The leaderboard is publicly readable so users
    // do NOT need to log in to see rankings.
    //
    // A student can create/update ONLY their own entry.
    //
    // --------------------------------------------------

    match /daily_leaderboards/{leaderboardId}/entries/{uid} {

      // ------------------------------------------------
      // PUBLIC READ
      // ------------------------------------------------
      //
      // Anyone can see the live leaderboard.
      // No login required.

      allow read:
        if true;


      // ------------------------------------------------
      // CREATE
      // ------------------------------------------------
      //
      // A logged-in student can create only their
      // own leaderboard entry.

      allow create:
        if signedIn()
        && uid == request.auth.uid

        && request.resource.data.userId ==
          request.auth.uid

        && request.resource.data.date is string

        && request.resource.data.section
          in ['quant', 'varc', 'dilr']

        && request.resource.data.score is number

        && request.resource.data.correct is number

        && request.resource.data.wrong is number

        && request.resource.data.total is number

        && leaderboardId ==
          request.resource.data.date + '_' +
          request.resource.data.section;


      // ------------------------------------------------
      // UPDATE
      // ------------------------------------------------
      //
      // A student can update only their own entry.
      //
      // This is important because the application uses
      // transaction.set() for the leaderboard entry.
      //
      // If the document already exists, Firestore treats
      // that operation as an update.

      allow update:
        if signedIn()
        && uid == request.auth.uid

        && resource.data.userId ==
          request.auth.uid

        && request.resource.data.userId ==
          request.auth.uid

        && request.resource.data.date ==
          resource.data.date

        && request.resource.data.section ==
          resource.data.section

        && request.resource.data.score is number

        && request.resource.data.correct is number

        && request.resource.data.wrong is number

        && request.resource.data.total is number

        && leaderboardId ==
          request.resource.data.date + '_' +
          request.resource.data.section;


      // ------------------------------------------------
      // DELETE
      // ------------------------------------------------
      //
      // Students cannot delete leaderboard entries.
      // Admin can delete them.

      allow delete:
        if isAdmin();
    }


    // --------------------------------------------------
    // GENERAL ATTEMPTS
    // --------------------------------------------------

    match /attempts/{attemptId} {

      allow read:
        if signedIn()
        && (
          resource.data.userId ==
            request.auth.uid
          || isAdmin()
        );


      allow create:
        if signedIn()
        && request.resource.data.userId ==
          request.auth.uid;


      allow update:
        if signedIn()
        && (
          resource.data.userId ==
            request.auth.uid
          || isAdmin()
        );


      allow delete:
        if isAdmin();
    }


    // --------------------------------------------------
    // ATTEMPT ANSWERS
    // --------------------------------------------------

    match /attempt_answers/{answerId} {

      allow read:
        if signedIn()
        && (
          resource.data.userId ==
            request.auth.uid
          || isAdmin()
        );


      allow create:
        if signedIn()
        && request.resource.data.userId ==
          request.auth.uid;


      allow update:
        if signedIn()
        && (
          isAdmin()
          ||
          (
            resource.data.userId ==
              request.auth.uid
            &&
            request.resource.data.userId ==
              request.auth.uid
          )
        );


      allow delete:
        if isAdmin();
    }


    // --------------------------------------------------
    // RESULTS
    // --------------------------------------------------

    match /results/{resultId} {

      allow read:
        if signedIn()
        && (
          resource.data.userId ==
            request.auth.uid
          || isAdmin()
        );


      // Results remain admin/server controlled.

      allow create, update, delete:
        if isAdmin();
    }


    // --------------------------------------------------
    // MATERIAL CATEGORIES
    // --------------------------------------------------

    match /material_categories/{id} {

      allow read:
        if signedIn();

      allow create, update, delete:
        if isAdmin();
    }


    // --------------------------------------------------
    // MATERIALS
    // --------------------------------------------------

    match /materials/{id} {

      allow read:
        if signedIn()
        && (
          resource.data.published == true
          || isAdmin()
        );

      allow create, update, delete:
        if isAdmin();
    }


    // --------------------------------------------------
    // ADMIN LOGS
    // --------------------------------------------------

    match /admin_logs/{id} {

      allow read, create, update, delete:
        if isAdmin();
    }
  }
}